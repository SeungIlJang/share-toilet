# 네이버 지도 API Client ID (ncp) - https://console.ncloud.com
VITE_NAVER_CLIENT_ID=your_naver_client_id

# 서울 열린데이터광장 공중화장실 API 인증키 - https://data.seoul.go.kr
VITE_SEOUL_API_KEY=your_seoul_api_key

# 서울 실시간 API 우선 사용 (true: 서울=실시간 우선 + 실패 시 data.json 폴백)
VITE_USE_LIVE_API=true

# 서울시 공중화장실 실시간 서비스명 (서울 열린데이터광장)
VITE_SEOUL_TOILET_SERVICE=GeoInfoPublicToiletWGS

# 기본 반경(m) - '내 주변' 검색 초기값
VITE_DEFAULT_RADIUS=1000

# 원격 최신 데이터 URL (앱 재배포 없이 데이터 갱신). 비우면 로컬 번들만 사용.
VITE_DATA_URL=https://share-toilet.onrender.com/data.json

# Google AdMob (기본값은 Google 공식 Android 테스트 광고)
# 운영 ID를 적용할 때만 true로 변경하고, ADMOB_APP_ID는 Gradle 환경변수/속성으로 주입합니다.
VITE_ADMOB_LIVE=false
VITE_ADMOB_BANNER_ID=ca-app-pub-3940256099942544/6300978111
